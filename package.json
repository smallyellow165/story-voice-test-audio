{
  "name": "story-voice-test-audio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server.mjs",
    "dev:vite": "node --watch --env-file-if-exists=.env server.mjs",
    "dev:brick": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "test": "node --test",
    "test:brick": "node --experimental-strip-types --test test/brick-assembly.test.mjs",
    "test:brick-inventory": "node --experimental-strip-types --test test/brick-inventory.test.mjs",
    "test:brick-session-game": "node --experimental-strip-types --test test/brick-session-game.test.mjs test/brick-building.test.mjs",
    "test:brick-generator": "node --test test/brick-generator.test.mjs",
    "test:star-jump-dataset": "node --test test/star-jump-dataset-exporter.test.mjs",
    "test:star-jump:unseen": "node scripts/run-star-jump-unseen.mjs",
    "test:star-jump:unseen:verify": "node --test test/star-jump-unseen.test.mjs",
    "test:pose-classifier:e2e": "node scripts/run-pose-classifier-e2e.mjs",
    "export:star-jump-dataset": "node scripts/export-star-jump-dataset.mjs",
    "backfill-duration": "node scripts/backfill-audio-duration.mjs",
    "preview": "vite preview",
    "build:module": "tsc && vite build --config vite.module.config.ts",
    "watch:module": "vite build --config vite.module.config.ts --watch",
    "reading:replay": "node scripts/reading-tracker.mjs",
    "test:reading": "node --test test/reading-tracker.test.mjs",
    "test:brick-building": "node --experimental-strip-types --test test/brick-building.test.mjs",
    "test:magnetic-catalog-tab": "node --experimental-strip-types --test test/magnetic-catalog-tab.test.mjs",
    "test:magnetic-catalog:browser": "node scripts/verify-magnetic-catalog.mjs",
    "test:magnetic-selected": "node --experimental-strip-types --test test/magnetic-selected-snapshots.test.mjs",
    "test:magnetic-selected:browser": "node scripts/verify-magnetic-selected.mjs",
    "test:magnetic-review-ui": "node --experimental-strip-types --test test/magnetic-review-edit.test.mjs",
    "test:magnetic-review-ui:browser": "node scripts/verify-magnetic-review-ui.mjs",
    "test:magnetic-relative-size": "node --experimental-strip-types --test test/magnetic-relative-size.test.mjs",
    "test:magnetic-relative-size:browser": "node scripts/verify-magnetic-relative-size.mjs",
    "test:magnetic-tiles": "node --experimental-strip-types --test test/magnetic-tiles.test.mjs",
    "test:magnetic-tiles:browser": "node scripts/verify-magnetic-tiles.mjs",
    "test:magnetic-build": "node --experimental-strip-types --test test/magnetic-build.test.mjs",
    "test:magnetic-build:browser": "node scripts/verify-magnetic-build.mjs",
    "test:magnetic-intake": "node --experimental-strip-types --test test/magnetic-intake.test.mjs",
    "test:magnetic-intake:browser": "node scripts/verify-magnetic-intake.mjs",
    "test:magnetic-mosaic": "node --experimental-strip-types --test test/magnetic-mosaic.test.mjs",
    "test:magnetic-mosaic:browser": "node scripts/verify-magnetic-mosaic.mjs",
    "test:magnetic-workflow-ui:browser": "node scripts/verify-magnetic-workflow-ui.mjs"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^7.0.0",
    "@google/genai": "2.21.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "diff": "^9.0.0",
    "fish-audio": "0.1.0",
    "google-auth-library": "^11.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.3",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.180.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "exports": {
    "./hopscotch-core": {
      "types": "./src/hopscotch-core.ts",
      "import": "./dist-module/hopscotch-core.js"
    },
    "./ringfeet": {
      "types": "./src/ring-feet-module.d.ts",
      "import": "./dist-module/index.js"
    },
    "./touch-color": {
      "types": "./src/touch-color-module.d.ts",
      "import": "./dist-module/touch-color.js"
    },
    "./simon-says": {
      "types": "./src/simon-says-module.d.ts",
      "import": "./dist-module/simon-says.js"
    },
    "./permissions": {
      "types": "./src/game-permissions.ts",
      "import": "./dist-module/permissions.js"
    },
    "./hopscotch": {
      "types": "./src/hopscotch-module.d.ts",
      "import": "./dist-module/hopscotch.js"
    },
    "./hopscotch-scripts": {
      "types": "./src/hopscotch-scripts.ts",
      "import": "./dist-module/hopscotch-scripts.js"
    },
    "./storybook-navigation": {
      "types": "./src/storybook-navigation.ts",
      "import": "./dist-module/storybook-navigation.js"
    },
    "./reading-tracker": {
      "types": "./src/reading-tracker.ts",
      "import": "./dist-module/reading-tracker.js"
    },
    "./ble-switch": {
      "types": "./src/ble-switch-module.d.ts",
      "import": "./dist-module/ble-switch.js"
    },
    "./brick-building": {
      "types": "./src/brick-building-module.d.ts",
      "import": "./dist-module/brick-building.js"
    },
    "./lego-gallery": {
      "types": "./src/brick-gallery-module.d.ts",
      "import": "./dist-module/lego-gallery.js"
    }
  }
}
