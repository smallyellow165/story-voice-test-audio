{
  "name": "story-voice-test-audio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs",
    "dev:vite": "node --env-file-if-exists=.env server.mjs",
    "build": "tsc && vite build",
    "test": "node --test",
    "test:star-jump-dataset": "node --test test/star-jump-dataset-exporter.test.mjs",
    "test:star-jump:unseen": "node scripts/run-star-jump-unseen.mjs",
    "test:star-jump:unseen:verify": "node --test test/star-jump-unseen.test.mjs",
    "test:pose-classifier:e2e": "node scripts/run-pose-classifier-e2e.mjs",
    "export:star-jump-dataset": "node scripts/export-star-jump-dataset.mjs",
    "backfill-duration": "node scripts/backfill-audio-duration.mjs",
    "preview": "vite preview",
    "build:module": "tsc && vite build --config vite.module.config.ts",
    "watch:module": "vite build --config vite.module.config.ts --watch"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^7.0.0",
    "@google/genai": "2.21.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "google-auth-library": "^11.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "exports": {
    "./ringfeet": {
      "types": "./src/ring-feet-module.d.ts",
      "import": "./dist-module/index.js"
    },
    "./touch-color": {
      "types": "./src/touch-color-module.d.ts",
      "import": "./dist-module/touch-color.js"
    },
    "./simon-says": {
      "types": "./src/simon-says-module.d.ts",
      "import": "./dist-module/simon-says.js"
    },
    "./permissions": {
      "types": "./src/game-permissions.ts",
      "import": "./dist-module/permissions.js"
    }
  }
}
