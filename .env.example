# Cloud Text-to-Speech uses Application Default Credentials (ADC).
# For local development, run: gcloud auth application-default login
#
# Alternatively, point this to a local service-account JSON key. Do not commit it.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# Recommended when using a service-account key or a quota project.
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# Optional local server settings.
# HOST=0.0.0.0
# PORT=5173

# DUPLO local viewer: optional override, otherwise uses the existing official library.
# For dev:brick / preview, export this in the launching shell.
# LDRAW_LIBRARY_PATH=/home/umi/Documents/pg/gaming/lego-brick/complete/ldraw

# Independent Gemini Developer API image baseline (server-side only).
# Get an API key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# Optional default for Developer API ring detection (independent of Vertex RING_LLM_MODEL).
# GEMINI_RING_MODEL=gemini-3.6-flash

# DUPLO V3 uses the same server-side GEMINI_API_KEY, with an independent model.
# DUPLO_LLM_MODEL=gemini-3.6-flash
# UI also offers gemini-3.1-pro-preview; this variable selects the initial default.
# Known Flash/Pro models use MEDIUM thinking and 32768 combined output tokens.
# Custom server model IDs retain provider thinking defaults; verify their capabilities yourself.

# Fish Audio offline TTS (server-side only). Model ID is the voice reference,
# not the inference model name; the app uses s2.1-pro-free.
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL_ID=

# Manual DUPLO Catalog: existing local Application Server (My-Good-GYM).
# Keep DB credentials and REBRICKABLE_API_KEY in that server, not this client.
# APPLICATION_SERVER_URL=http://127.0.0.1:8001
# Optional DUPLO image recognition model. Empty uses DUPLO_LLM_MODEL / existing Generator default.
# Uses the existing server-side GEMINI_API_KEY; never put credentials in browser code.
DUPLO_VISION_MODEL=

# Optional OpenAI inventory image recognition. Uses the official Responses API.
# gpt-4.1 is the existing V4 OpenAI model and supports image input.
# Inventory UI also offers gpt-6.1-sol, gpt-6-luna and gpt-6-astra through
# the same Responses endpoint and OPENAI_API_KEY; GPT-6 reasoning effort is medium.
# Configure this in Test Audio's .env; never expose it as a VITE_* variable.
# OPENAI_API_KEY=
